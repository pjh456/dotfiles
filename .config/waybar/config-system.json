{
  "name": "system-bar",
  "layer": "top",
  "position": "bottom",
  "height": 32,
  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "bluetooth", "pulseaudio", "backlight", "cpu", "memory", "disk", "battery", "tray"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "on-click": "activate",
    "persistent_workspaces": { "1": [], "2": [], "3": [], "4": [], "5": [] }
  },
  "custom/launcher": {
    "format": "  Menu",
    "on-click": "rofi -show drun",
    "tooltip": false
  },
  "clock": {
    "format": "   {:%H:%M  %m/%d (%a)}  ",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "interval": 30
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 5,
    "on-click": "foot btop"
  },
  "memory": {
    "format": " {}%",
    "interval": 5,
    "on-click": "foot btop"
  },
  "disk": {
    "format": " {percentage_used}%",
    "interval": 30,
    "on-click": "foot df"
  },
  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "󰈁 Connected",
    "format-disconnected": "󰤮",
    "tooltip-format": "{ifname}  IP: {ipaddr}/{cidr}  GW: {gwaddr}",
    "on-click": "foot nmtui",
    "interval": 10
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "  Muted",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃝", "󰃟", "󰃠"],
    "on-click": "brightnessctl set 1%-",
    "on-click-right": "brightnessctl set +1%",
    "scroll-step": 5
  },
  "bluetooth": {
    "format": " {status}",
    "format-disabled": "",
    "format-connected": " {device_alias}",
    "tooltip-format": "{device_alias}",
    "on-click": "blueman-manager"
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": "",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰁹"],
    "on-click": "foot btop"
  },
  "tray": {
    "spacing": 8
  }
}

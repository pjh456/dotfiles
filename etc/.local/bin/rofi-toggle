#!/bin/dash
# Toggle a rofi menu. Rofi refuses to start a second instance ("already
# running"), so a second press on the waybar button or the keybind used to
# leave the old window open with an error in the journal. Instead, close the
# open menu and launch a new one otherwise.
if pgrep -x rofi >/dev/null 2>&1; then
    pkill -x rofi
    exit 0
fi
exec rofi "$@"

#!/bin/dash
# 天气: 中国海洋大学西海岸校区 (青岛西海岸新区古镇口)
# 供 waybar 顶栏天气模块轮询；一次请求同时缓存 7 天预报，
# 让 weather-forecast 点击时不用再联网。
LAT=35.775
LON=120.030
PLACE="中国海洋大学西海岸校区"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/waybar-weather.json"
TTL=1500
TIMEOUT=6

I_SUN=''
I_PART=''
I_CLOUD=''
I_FOG=''
I_RAIN=''
I_SHOWER=''
I_SNOW=''
I_THUN=''
I_DRIZ=''

wmo() {
    case "$1" in
        0)              echo "$I_SUN|晴" ;;
        1)              echo "$I_PART|晴间多云" ;;
        2)              echo "$I_PART|多云" ;;
        3)              echo "$I_CLOUD|阴" ;;
        45|48)          echo "$I_FOG|雾" ;;
        51|53|55|56|57) echo "$I_DRIZ|毛毛雨" ;;
        61|63|65|66|67) echo "$I_RAIN|雨" ;;
        71|73|75|77)    echo "$I_SNOW|雪" ;;
        80|81|82)       echo "$I_SHOWER|阵雨" ;;
        85|86)          echo "$I_SNOW|阵雪" ;;
        95|96|99)       echo "$I_THUN|雷阵雨" ;;
        *)              echo "$I_CLOUD|未知" ;;
    esac
}

emit() {
    line=$(wmo "$2")
    icon=${line%%|*}
    desc=${line#*|}
    printf '{"text":" %s  %s°C","tooltip":"%s\\n%s  %s°C (体感 %s°C)\\n湿度 %s%%","class":"wmo%s"}\n' \
        "$icon" "$1" "$PLACE" "$desc" "$1" "$3" "$4" "$2"
}

# 一次请求同时拿实况和 7 天预报：weather-forecast 点击时直接读这份缓存，
# 不再联网，所以是毫秒级弹出。
fetch() {
    curl -sf --max-time "$TIMEOUT" \
        "https://api.open-meteo.com/v1/forecast?latitude=$LAT&longitude=$LON&timezone=Asia%2FShanghai&forecast_days=7&current=temperature_2m,weather_code,apparent_temperature,relative_humidity_2m,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,sunrise,sunset,wind_speed_10m_max" \
        2>/dev/null
}

# 原子写入：后台刷新时 weather-forecast 可能正在读同一份缓存。
save() {
    tmp="$CACHE.$$.tmp"
    if [ -n "$1" ] && printf '%s\n' "$1" | jq -c --argjson ts "$(date +%s)" '. + {ts:$ts}' > "$tmp" 2>/dev/null; then
        mv "$tmp" "$CACHE"
    else
        rm -f "$tmp"
    fi
}

show_cache() {
    cur=$(jq -r 'select(.current.temperature_2m != null) | [.current.temperature_2m, .current.weather_code, .current.apparent_temperature, .current.relative_humidity_2m] | @tsv' "$CACHE" 2>/dev/null)
    [ -n "$cur" ] || return 1
    emit "$(printf '%s' "$cur" | cut -f1)" "$(printf '%s' "$cur" | cut -f2)" \
         "$(printf '%s' "$cur" | cut -f3)" "$(printf '%s' "$cur" | cut -f4)"
}

if [ -f "$CACHE" ]; then
    ts=$(jq -r '.ts // 0' "$CACHE" 2>/dev/null)
    if [ -n "$ts" ] && [ $(( $(date +%s) - ts )) -lt "$TTL" ]; then
        show_cache && exit 0
    fi
    ( raw=$(fetch); save "$raw" ) >/dev/null 2>&1 &
    show_cache && exit 0
fi

raw=$(fetch)
save "$raw"
show_cache && exit 0

printf '{"text":"","tooltip":"%s: 无法获取数据"}\n' "$PLACE"

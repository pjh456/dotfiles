#!/bin/dash
# 中国海洋大学西海岸校区 7 天预报 (rofi 弹出)
# 数据由 ~/.local/bin/weather 预取到同一份缓存：点击时只读缓存 + 解析，
# 不再联网，所以是毫秒级弹出。
PLACE="中国海洋大学西海岸校区"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/waybar-weather.json"

I_SUN=''
I_PART=''
I_CLOUD=''
I_FOG=''
I_RAIN=''
I_SHOWER=''
I_SNOW=''
I_THUN=''
I_DRIZ=''

# 直接给 icon/desc 赋值，而不是 $(icon_for ...)：dash 的 $(printf) 在长
# 多字节格式串上会插入垃圾字节（例如把"风"写成 e9 a3 81...8e），而且每行
# 两次 fork 也没必要。
set_wmo() {
    case "$1" in
        0)              icon=$I_SUN;    desc=晴 ;;
        1)              icon=$I_PART;   desc=晴间多云 ;;
        2)              icon=$I_PART;   desc=多云 ;;
        3)              icon=$I_CLOUD;  desc=阴 ;;
        45|48)          icon=$I_FOG;    desc=雾 ;;
        51|53|55)       icon=$I_DRIZ;   desc=毛毛雨 ;;
        56|57)          icon=$I_DRIZ;   desc=冻雨 ;;
        61|63|65)       icon=$I_RAIN;   desc=雨 ;;
        66|67)          icon=$I_RAIN;   desc=冻雨 ;;
        71|73|75|77)    icon=$I_SNOW;   desc=雪 ;;
        80|81|82)       icon=$I_SHOWER; desc=阵雨 ;;
        85|86)          icon=$I_SNOW;   desc=阵雪 ;;
        95|96|99)       icon=$I_THUN;   desc=雷阵雨 ;;
        *)              icon=$I_CLOUD;  desc=未知 ;;
    esac
}

# 已经开着就再点一下关掉（rofi 不会启动第二个实例）
if pgrep -x rofi >/dev/null 2>&1; then
    pkill -x rofi
    exit 0
fi

# 缓存正常就直接用；完全没有数据时让 weather 同步抓一次（只在首次点击发生）
if ! jq -e '.daily.time' "$CACHE" >/dev/null 2>&1; then
    "$HOME/.local/bin/weather" >/dev/null 2>&1
fi
if ! jq -e '.daily.time' "$CACHE" >/dev/null 2>&1; then
    printf '' | rofi -dmenu -p " 天气" -mesg "$PLACE: 无法获取数据"
    exit 0
fi

# 当前实况头
cur=$(jq -r '[.current.temperature_2m, .current.weather_code, .current.apparent_temperature, .current.relative_humidity_2m, .current.wind_speed_10m] | @tsv' "$CACHE")
cur_t=$(printf '%s' "$cur" | cut -f1)
cur_c=$(printf '%s' "$cur" | cut -f2)
cur_f=$(printf '%s' "$cur" | cut -f3)
cur_h=$(printf '%s' "$cur" | cut -f4)
cur_w=$(printf '%s' "$cur" | cut -f5)

set_wmo "$cur_c"
cur_icon=$icon
cur_desc=$desc

# 7 天
rows=$(jq -r '
  .daily as $d |
  [range(0; ($d.time|length))] |
  map("\($d.time[.])|\($d.weather_code[.])|\($d.temperature_2m_max[.])|\($d.temperature_2m_min[.])|\($d.precipitation_probability_max[.] // "-")|\($d.precipitation_sum[.] // 0)|\($d.wind_speed_10m_max[.] // 0)|\($d.sunrise[.])|\($d.sunset[.])") |
  .[]' "$CACHE" 2>/dev/null)

today=$(date +%Y-%m-%d)
idx=0

# 逐行直接写进临时文件：既避开 dash 的 $(printf) 多字节 bug，也省掉每行
# 一次命令替换。rofi 最后直接从这份文件读。
tmp="${TMPDIR:-/tmp}/weather-forecast.$$"
trap 'rm -f "$tmp"' EXIT
while IFS='|' read -r d code tmax tmin pop _psum wind sr ss; do
    [ -z "$d" ] && continue
    set_wmo "$code"
    # %a is localised (zh_CN gives "一" too, but a mismatched locale would
    # leave English names); map the ISO weekday number instead. The ideographic
    # space keeps "一" the same width as the two-character 今天 / 明天.
    wd=$(date -d "$d" +%u 2>/dev/null)
    md=$(date -d "$d" +%m/%d 2>/dev/null)
    case "$wd" in
        1) dow="一　" ;; 2) dow="二　" ;; 3) dow="三　" ;; 4) dow="四　" ;;
        5) dow="五　" ;; 6) dow="六　" ;; 7) dow="日　" ;; *) dow="?　" ;;
    esac

    if [ "$d" = "$today" ]; then label="今天"; color="#89b4fa"
    elif [ $idx -eq 1 ]; then label="明天"; color="#a6e3a1"
    else label="$dow"; color="#cdd6f4"; fi

    sr_h=$(printf '%s' "$sr" | cut -dT -f2)
    ss_h=$(printf '%s' "$ss" | cut -dT -f2)

    # 等宽列：温度、概率、风速、日照都是变长数字，先四舍五入并按位补齐，
    # 再把可变的中文天气描述放到行尾，这样每天的图标/数字才会严格对齐。
    tmax_w=$(printf '%3s' "$(printf '%.0f' "$tmax")")
    tmin_w=$(printf '%3s' "$(printf '%.0f' "$tmin")")
    pop_w=$(printf '%3s' "$pop")
    wind_w=$(printf '%3s' "$(printf '%.0f' "$wind")")

    printf '<span foreground="%s" weight="bold">%s %s</span>  %s  <span foreground="#f9e2af">%s°</span> / <span foreground="#89b4fa">%s°</span>  <span foreground="#94e2d5">%s%%</span>  <span foreground="#9399b2">󰖝 %s km/h  %s-%s</span>  <span foreground="#a6adc8">%s</span>\n' \
        "$color" "$label" "$md" "$icon" "$tmax_w" "$tmin_w" "$pop_w" "$wind_w" "$sr_h" "$ss_h" "$desc" >> "$tmp"

    idx=$((idx+1))
done <<EOF
$rows
EOF

# 头部（实况）写在行的前面
{
    printf '<span foreground="#cba6f7" weight="bold">%s</span>  %s <span foreground="#f9e2af">%s°C</span>  <span foreground="#9399b2">体感 %s° 湿度 %s%% 风 %skm/h</span>\n' \
        "$PLACE" "$cur_icon $cur_desc" "$cur_t" "$cur_f" "$cur_h" "$cur_w"
    cat "$tmp"
} | rofi -dmenu -markup-rows -p " 天气" \
    -theme-str 'window { width: 780px; border-radius: 16px; border: 2px; border-color: #89b4fa55; background-color: #181825e6; }
                mainbox { padding: 14px; spacing: 10px; }
                listview { lines: 8; columns: 1; spacing: 4px; }
                element { padding: 8px 14px; border-radius: 10px; }
                element normal.normal { background-color: transparent; text-color: #cdd6f4; }
                element alternate.normal { background-color: transparent; text-color: #cdd6f4; }
                element selected.normal { background-color: #313244cc; text-color: #cdd6f4; border: 1px; border-color: #89b4fa66; }
                element-text { font: "JetBrainsMono Nerd Font 12"; }'

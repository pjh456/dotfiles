#!/bin/dash
if [ -z "$1" ]; then
    echo "Usage: setwp <image_path>"
    exit 1
fi
if [ ! -f "$1" ]; then
    echo "Error: file not found: $1"
    exit 1
fi
wp=$(realpath "$1")
hyprctl hyprpaper "wallpaper ,$wp"

# Remember the current wallpaper so hyprlock and the next session can reuse it.
cache="${XDG_CACHE_HOME:-$HOME/.cache}"
mkdir -p "$cache"
ln -sf "$wp" "$cache/current_wallpaper"

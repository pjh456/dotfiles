#!/bin/dash
# Second press closes the open menu instead of failing to start a new rofi.
if pgrep -x rofi >/dev/null 2>&1; then
  pkill -x rofi
  exit 0
fi
item=$(cliphist list | rofi -dmenu -p " Clipboard" -display-columns 2 -theme-str '
  window { width: 720px; }
  listview { columns: 1; lines: 12; }
  element { padding: 8px 12px; }
')
if [ -n "$item" ]; then
  content=$(printf '%s' "$item" | cliphist decode 2>/dev/null)
  if [ -n "$content" ]; then
    notify-send -i edit-paste "Clipboard" "Copied, press Ctrl+V to paste"
    echo "$content" | wl-copy --paste-once
  fi
fi

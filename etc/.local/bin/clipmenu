#!/bin/dash
item=$(cliphist list | rofi -dmenu -p " Clipboard" -display-columns 2 -width 50 -l 15)
if [ -n "$item" ]; then
  content=$(printf '%s' "$item" | cliphist decode 2>/dev/null)
  if [ -n "$content" ]; then
    notify-send -i edit-paste "Clipboard" "Copied, press Ctrl+V to paste"
    echo "$content" | wl-copy --paste-once
  fi
fi

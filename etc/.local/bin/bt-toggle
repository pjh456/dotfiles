#!/bin/bash
BT_SERVICE="bluetooth.service"

status() {
  if systemctl is-active --quiet "$BT_SERVICE" 2>/dev/null; then
    power=$(bluetoothctl show 2>/dev/null | grep "Powered:" | awk '{print $2}')
    if [ "$power" = "yes" ]; then
      connected=$(bluetoothctl devices Connected 2>/dev/null | wc -l)
      if [ "$connected" -gt 0 ]; then
        alias=$(bluetoothctl devices Connected 2>/dev/null | head -1 | cut -d' ' -f3-)
        echo "{\"text\":\"\uf294 ${alias}\",\"class\":\"connected\",\"tooltip\":\"${alias}\"}"
      else
        echo "{\"text\":\"\uf294 on\",\"class\":\"on\",\"tooltip\":\"Bluetooth on\"}"
      fi
    else
      echo "{\"text\":\"\uf294 off\",\"class\":\"off\",\"tooltip\":\"Bluetooth off\"}"
    fi
  else
    echo "{\"text\":\"\uf294 off\",\"class\":\"off\",\"tooltip\":\"Bluetooth off\"}"
  fi
}

toggle() {
  local changed=0
  if systemctl is-active --quiet "$BT_SERVICE" 2>/dev/null; then
    power=$(bluetoothctl show 2>/dev/null | grep "Powered:" | awk '{print $2}')
    if [ "$power" = "no" ]; then
      bluetoothctl power on
      changed=1
    fi
  else
    sudo systemctl start "$BT_SERVICE"
    sleep 2
    bluetoothctl power on
    changed=1
  fi
  if [ "$changed" = 1 ]; then
    for i in $(seq 1 10); do
      power=$(bluetoothctl show 2>/dev/null | grep "Powered:" | awk '{print $2}')
      [ "$power" = "yes" ] && break
      sleep 0.3
    done
    pkill -RTMIN+1 waybar 2>/dev/null
  fi
  blueman-manager
  pkill -RTMIN+1 waybar 2>/dev/null
}

case "${1:-status}" in
  status) status ;;
  toggle) toggle ;;
esac

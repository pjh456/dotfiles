#!/bin/dash
# 用法: mpv-profile-switch [profile]
#   profile: D-Bus/TLP 的 profile 名（performance / balanced / power-saver，
#            也接受 tlp-stat 的 PRF/SAV 形式）。
# 不带参数时从 TLP 读取当前值（单次约 90ms）；mpv-profile-watch 会把
# D-Bus 事件里已经拿到的值直接传进来，省掉这次调用。
if [ -n "${1:-}" ]; then
    raw=$1
else
    raw=$(tlp-stat -s 2>/dev/null | grep -oP 'TLP profile\s*=\s*\K\S+' || echo "balanced/BAT")
fi

tlp_profile=${raw%/*}
case "$tlp_profile" in
    PRF|performance)                target=PRF ;;
    SAV|save|powersave|power-saver) target=SAV ;;
    *)                              target=BAL ;;
esac

link="$HOME/.config/mpv/mpv.conf"
want="$HOME/.config/mpv/mpv.conf.$target"

# 幂等：已经指向目标就不再动，避免事件重复时刷日志/改 mtime
[ "$(readlink "$link" 2>/dev/null)" = "$want" ] && exit 0

ln -sf "$want" "$link"
echo "[mpv-profile] switched to $target"

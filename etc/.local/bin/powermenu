#!/bin/dash

# Second press closes the open menu instead of failing to start a new rofi.
if pgrep -x rofi >/dev/null 2>&1; then
  pkill -x rofi
  exit 0
fi

i_lock=""
i_suspend=""
i_logout=""
i_reboot=""
i_shutdown=""

# Icon-only horizontal menu; `-format i` returns the 0-based index.
selected=$(printf '%s\n%s\n%s\n%s\n%s\n' \
  "$i_lock" "$i_suspend" "$i_logout" "$i_reboot" "$i_shutdown" |
  rofi -dmenu -format i -p " Power" -theme-str '
    window { width: 520px; border-radius: 16px; border: 2px; border-color: #cba6f766; background-color: #181825e0; }
    mainbox { children: [listview]; padding: 16px; }
    listview { columns: 5; lines: 1; spacing: 12px; layout: vertical; border: 0px; }
    /* config.rasi sets show-icons, so rofi reserves a 28px element-icon slot
       (plus the 10px element spacing) on the left of every row. The rows have
       no icon; dropping the slot lets the glyph sit in the middle of the tile. */
    element { children: [element-text]; padding: 22px 0px; border: 0px; border-radius: 12px; background-color: #31324499; }
    element normal.normal { background-color: #31324499; }
    element alternate.normal { background-color: #31324499; }
    /* Same blue -> mauve accent as the launcher pill and the active
       workspace, instead of the red "danger" colour. */
    element selected.normal { background-image: linear-gradient(135deg, #89b4fa, #cba6f7); text-color: #11111b; }
    /* The Propo (proportional) face is required for centring: in the regular
       Nerd Font the patched glyphs keep a narrow monospace advance while the
       ink is much wider, so rofi centres the advance and the icon drifts
       right (by up to 9px for the wide ones). Propo advances match the ink. */
    element-text { font: "JetBrainsMono Nerd Font Propo 24"; horizontal-align: 0.5; vertical-align: 0.5; }
  ')

case "$selected" in
  0) hyprlock ;;
  1) systemctl suspend ;;
  2) hyprctl eval 'hl.dsp.exit()' ;;
  3) reboot ;;
  4) poweroff ;;
esac

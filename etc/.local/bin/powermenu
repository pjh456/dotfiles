#!/bin/dash

# Second press closes the open menu instead of failing to start a new rofi.
if pgrep -x rofi >/dev/null 2>&1; then
  pkill -x rofi
  exit 0
fi

i_lock=""
i_suspend=""
i_logout=""
i_reboot=""
i_shutdown=""

# Icon-only horizontal menu; `-format i` returns the 0-based index.
selected=$(printf '%s\n%s\n%s\n%s\n%s\n' \
  "$i_lock" "$i_suspend" "$i_logout" "$i_reboot" "$i_shutdown" |
  rofi -dmenu -format i -p " Power" -theme-str '
    window { width: 520px; border-radius: 16px; border: 2px; border-color: #cba6f766; background-color: #181825e0; }
    mainbox { children: [listview]; padding: 16px; }
    listview { columns: 5; lines: 1; spacing: 12px; layout: vertical; border: 0px; }
    element { padding: 22px 0px; border: 0px; border-radius: 12px; background-color: #31324499; }
    element normal.normal { background-color: #31324499; }
    element alternate.normal { background-color: #31324499; }
    element selected.normal { background-color: #f38ba8; text-color: #11111b; }
    element-text { font: "JetBrainsMono Nerd Font 24"; horizontal-align: 0.5; vertical-align: 0.5; }
  ')

case "$selected" in
  0) hyprlock ;;
  1) systemctl suspend ;;
  2) hyprctl eval 'hl.dsp.exit()' ;;
  3) reboot ;;
  4) poweroff ;;
esac

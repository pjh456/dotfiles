configuration {
  modi: "drun,calc,emoji";
  font: "JetBrainsMono Nerd Font 14";
  icon-theme: "Papirus-Dark";
  show-icons: true;
  drun-display-format: "{name}";
  display-drun: "   Apps";
  display-calc: "   Calc";
  display-emoji: " 󰞅  Emoji";
}

* {
  bg:        #1e1e2e;
  bg-alt:    #181825;
  fg:        #cdd6f4;
  fg-alt:    #bac2de;
  dim:       #585b70;
  blue:      #89b4fa;
  green:     #a6e3a1;
  red:       #f38ba8;
  yellow:    #f9e2af;
  surface:   #313244;
  overlay:   #45475a;

  /* rofi 内置的 Solarized Light 默认值会穿透到没有显式定义的列表状态，
     表现为列表里出现米黄色/灰白色的交替行。这里把所有状态变量都固定
     到 Catppuccin Mocha，保证任何状态都不会回退到内置主题。 */
  background:                  #1e1e2e;
  foreground:                  #cdd6f4;
  border-color:                #45475a;
  separatorcolor:              #45475a;
  normal-background:           transparent;
  normal-foreground:           #cdd6f4;
  alternate-normal-background: transparent;
  alternate-normal-foreground: #cdd6f4;
  selected-normal-background:  #89b4fa;
  selected-normal-foreground:  #1e1e2e;
  active-background:           #a6e3a1;
  active-foreground:           #1e1e2e;
  selected-active-background:  #a6e3a1;
  selected-active-foreground:  #1e1e2e;
  alternate-active-background: transparent;
  alternate-active-foreground: #a6e3a1;
  urgent-background:           #1e1e2e;
  urgent-foreground:           #f38ba8;
  selected-urgent-background:  #f38ba8;
  selected-urgent-foreground:  #1e1e2e;
  alternate-urgent-background: transparent;
  alternate-urgent-foreground: #f38ba8;
}

window {
  background-color:           var(bg);
  text-color:                 var(fg);
  border-radius:              12px;
  border:                     1px;
  border-color:               var(overlay);
  width:                      600;
  padding:                    0px;
}

mainbox {
  children:           [inputbar, listview];
  background-color:   var(bg);
  border-radius:      12px;
  padding:            0px;
  spacing:            8px;
}

inputbar {
  children:           [prompt, entry, num-filtered-rows, case-indicator];
  background-color:   var(bg-alt);
  border-radius:      10px;
  padding:            10px 16px;
  margin:            10px 10px 0 10px;
  spacing:           12px;
}

prompt {
  text-color:         var(blue);
  font:               "JetBrainsMono Nerd Font 16";
}

entry {
  text-color:         var(fg);
  font:               "JetBrainsMono Nerd Font 14";
  placeholder:        "Search...";
}

num-filtered-rows {
  text-color:         var(dim);
  expand:             false;
}

case-indicator {
  text-color:         var(dim);
  expand:             false;
}

listview {
  background-color:   transparent;
  padding:            0px 10px 10px 10px;
  spacing:            4px;
  layout:             vertical;
  columns:            2;
  cycle:              true;
  dynamic:            true;
  scrollbar:          false;
}

element {
  background-color:   transparent;
  text-color:         var(fg);
  border-radius:      8px;
  padding:            8px 12px;
  spacing:           10px;
}

element normal {
  background-color:   transparent;
  text-color:         var(fg);
}

/* rofi 会按 normal/selected/alternate 组合选择最具体的选择器，
   不写这些子状态就会回退到内置的浅色主题。 */
element normal.normal {
  background-color:   transparent;
  text-color:         var(normal-foreground);
}

element alternate.normal {
  background-color:   transparent;
  text-color:         var(alternate-normal-foreground);
}

element selected.normal {
  background-color:   var(selected-normal-background);
  text-color:         var(selected-normal-foreground);
  border-radius:      8px;
}

element selected.urgent {
  background-color:   var(selected-urgent-background);
  text-color:         var(selected-urgent-foreground);
  border-radius:      8px;
}

element selected.active {
  background-color:   var(selected-active-background);
  text-color:         var(selected-active-foreground);
  border-radius:      8px;
}

element alternate.urgent {
  background-color:   transparent;
  text-color:         var(alternate-urgent-foreground);
}

element alternate.active {
  background-color:   transparent;
  text-color:         var(alternate-active-foreground);
}

element selected {
  background-color:   var(blue);
  text-color:         #1e1e2e;
  border-radius:      8px;
}

element urgent {
  background-color:   var(red);
  text-color:         #1e1e2e;
}

element active {
  background-color:   var(green);
  text-color:         #1e1e2e;
}

element-icon {
  size:               28px;
}

element-text {
  text-color:         inherit;
  font:               "JetBrainsMono Nerd Font 13";
  vertical-align:     0.5;
  horizontal-align:   0.0;
}

button {
  background-color:   var(surface);
  text-color:         var(fg);
  border-radius:      8px;
  padding:           8px;
}

button selected {
  background-color:   var(blue);
  text-color:         #1e1e2e;
}

error-message {
  background-color:   var(bg);
  border-radius:      12px;
  padding:           16px;
}

textbox {
  text-color:         var(fg);
  background-color:   transparent;
}

scrollbar {
  handle-color:       var(overlay);
  handle-width:       4px;
}

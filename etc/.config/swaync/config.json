{
  "positionX": "right",
  "positionY": "top",
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "layer": "overlay",
  "layer-shell": true,
  "cssPriority": "application",
  "notification-icon-size": 32,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "notification-placement": "top",
  "notification-inline-replies": false,
  "notification": {
    "compare": "auto"
  },
  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "",
          "type": "button",
          "command": "hyprlock"
        },
        {
          "label": "",
          "type": "button",
          "command": "sh -c '$HOME/.local/bin/bt-toggle toggle'"
        },
        {
          "label": "",
          "type": "button",
          "command": "systemctl suspend"
        },
        {
          "label": "",
          "type": "button",
          "command": "poweroff"
        },
        {
          "label": "",
          "type": "button",
          "command": "reboot"
        }
      ]
    },
    "volume": {
      "label": "",
      "min": 0,
      "max": 150,
      "step": 5
    },
    "backlight": {
      "label": "",
      "min": 0,
      "max": 100,
      "step": 5
    },
    "mpris": {
      "image-size": 40,
      "image-radius": 6
    }
  }
}
